  "formulas": {
    "max_hp": "(VIT + Level) * 20 + armor_hp",
    "max_mp": "INT * 15",
    "max_weight": "50 + STR * 5",
    "effective_atk": "weapon_atk * prof * (1 + enhance * 0.05)",
    "stat_bonus": "scaling_stat * 0.5 * prof",
    "basic_damage": "effective_atk + stat_bonus",
    "skill_damage": "basic_damage * skill_mult",
    "heal": "target_max_hp * heal_pct * prof * (1 + INT / 500) * (1 + weapon_heal_bonus)",
    "crit_rate": "min(0.50, PER * 0.005 + weapon_crit + enhance * 0.005)",
    "crit_mult": 1.5,
    "damage_taken": "incoming * K / (K + DEF), K = 100 + attacker_level * 20",
    "pvp_damage_mult": 0.4,
    "move_speed_tiles_per_sec": "4.0 * min(1.5, 1 + AGI / 400)",
    "attack_interval_sec": "1.0 / ((1 + AGI / 500) * (1 + weapon_attack_speed))",
    "dodge_rate": "min(0.30, AGI * 0.002)",
    "hp_regen": "out of combat 10s: 1% MaxHP / 3s * (1 + VIT / 200); in combat: 0"
  },

